# App Settings
PROJECT_NAME="AI Social Media Manager"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="change-me-in-production-super-secret-jwt-key"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/social_media_manager"

# Redis & Celery Task Queue
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI Credentials (Google Gemini, OpenAI, Modal GPU)
IMAGE_PROVIDER="openai"
MODAL_IMAGE_EDIT_URL=""
GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY="sk-..."
OPENAI_IMAGE_MODEL="gpt-image-1"

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Meta Instagram Graph API
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
